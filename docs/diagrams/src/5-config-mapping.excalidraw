   "link": null,
   "locked": false,
   "text": "kind: ClusterSecretStore\nmetadata:\n  name: demo-store\nspec:\n  provider:\n    fake:              # EKS: aws SecretsManager, same name\n      data:\n        - key: prod/orders-api/api-key\n          value: demo-value-for-prod",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "kind: ClusterSecretStore\nmetadata:\n  name: demo-store\nspec:\n  provider:\n    fake:              # EKS: aws SecretsManager, same name\n      data:\n        - key: prod/orders-api/api-key\n          value: demo-value-for-prod",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
