   "text": "environment: prod\n\nimage:\n  repository: ghcr.io/rosaliei/orders-api\n  tag: \"0.1.0\"\n  digest: \"\"\n\nautoscaling:\n  enabled: true\n  minReplicas: 2\n  maxReplicas: 4\n\nenv:\n  LOG_LEVEL: info\n\nsecretEnv:\n  enabled: true\n  data:\n    API_KEY: prod/orders-api/api-key\n\nmetrics:\n  enabled: true\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 96Mi\n  limits:\n    memory: 192Mi",
