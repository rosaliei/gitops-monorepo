  {
   "id": "EHUr9LYt9mIgt49ASIMKz",
   "type": "text",
   "x": 5550,
   "y": 1416,
   "width": 538.0519999999998,
   "height": 225,
   "angle": 0,
   "strokeColor": "#1e1e1e",
