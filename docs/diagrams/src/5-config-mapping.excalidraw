   "text": "{{- if .Values.secretEnv.enabled }}\nkind: ExternalSecret\nspec:\n  secretStoreRef:\n    kind: ClusterSecretStore\n    name: {{ .Values.secretEnv.store }}\n  target:\n    name: {{ .Release.Name }}-secrets\n  data:\n    {{- range $name, $remoteKey := .Values.secretEnv.data }}\n    - secretKey: {{ $name }}\n      remoteRef:\n        key: {{ $remoteKey }}\n    {{- end }}\n{{- end }}",
   "fontSize": 20,
   "baseFontSize": null,
