   "text": "4. templates turn values into Kubernetes objects",
   "fontSize": 18,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. templates turn values into Kubernetes objects",
   "autoResize": true,
   "lineHeight": 1.2,
   "labelPosition": null
  },
  {
   "id": "mVNvZ7_wmSj8q6Qi-YHVY",
   "type": "text",
   "x": 4150,
   "y": 286,
   "width": 548.0119999999998,
   "height": 750,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b6E",
   "roundness": null,
   "seed": 1181592900,
   "version": 3,
   "versionNonce": 566743676,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791141188886,
   "created": 1791141188880,
   "link": null,
   "locked": false,
   "text": "kind: Deployment\nmetadata:\n  name: {{ .Release.Name }}\nspec:\n  {{- if not .Values.autoscaling.enabled }}\n  replicas: {{ .Values.replicaCount }}\n  {{- end }}\n  template:\n    spec:\n      containers:\n        - name: {{ .Release.Name }}\n          image: {{ include \"app.image\" . }}\n          env:\n            - name: APP_ENV\n              value: {{ .Values.environment | quote }}\n            {{- range $name, $value := .Values.env }}\n            - name: {{ $name }}\n              value: {{ $value | quote }}\n            {{- end }}\n            {{- if .Values.secretEnv.enabled }}\n            {{- range $name, $_ := .Values.secretEnv.data }}\n            - name: {{ $name }}\n              valueFrom:\n                secretKeyRef:\n                  name: {{ $.Release.Name }}-secrets\n                  key: {{ $name }}\n            {{- end }}\n            {{- end }}\n          resources:\n            {{- toYaml .Values.resources | nindent 12 }}",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "kind: Deployment\nmetadata:\n  name: {{ .Release.Name }}\nspec:\n  {{- if not .Values.autoscaling.enabled }}\n  replicas: {{ .Values.replicaCount }}\n  {{- end }}\n  template:\n    spec:\n      containers:\n        - name: {{ .Release.Name }}\n          image: {{ include \"app.image\" . }}\n          env:\n            - name: APP_ENV\n              value: {{ .Values.environment | quote }}\n            {{- range $name, $value := .Values.env }}\n            - name: {{ $name }}\n              value: {{ $value | quote }}\n            {{- end }}\n            {{- if .Values.secretEnv.enabled }}\n            {{- range $name, $_ := .Values.secretEnv.data }}\n            - name: {{ $name }}\n              valueFrom:\n                secretKeyRef:\n                  name: {{ $.Release.Name }}-secrets\n                  key: {{ $name }}\n            {{- end }}\n            {{- end }}\n          resources:\n            {{- toYaml .Values.resources | nindent 12 }}",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
