   "link": null,
   "locked": false,
   "text": "kind: ApplicationSet\nmetadata:\n  name: demo-apps\nspec:\n  goTemplate: true\n  generators:\n    - git:\n        repoURL: https://github.com/rosaliei/gitops-monorepo.git\n        revision: main\n        files:\n          - path: \"environments/*/*.yaml\"\n  template:\n    metadata:\n      name: '{{ trimSuffix \".yaml\" .path.filename }}-{{ .path.basename }}'\n      annotations:\n        notifications.argoproj.io/subscribe.on-deployed.slack: gitops-demo\n    spec:\n      project: demo\n      source:\n        repoURL: https://github.com/rosaliei/gitops-monorepo.git\n        targetRevision: main\n        path: charts/app\n        helm:\n          releaseName: '{{ trimSuffix \".yaml\" .path.filename }}'\n          valueFiles:\n            - '../../{{ .path.path }}/{{ .path.filename }}'\n      destination:\n        server: https://kubernetes.default.svc\n        namespace: 'demo-{{ .path.basename }}'\n      syncPolicy:\n        automated:\n          prune: true\n          selfHeal: true\n        syncOptions:\n          - CreateNamespace=true\n        managedNamespaceMetadata:\n          labels:\n            gitops.demo/protected: \"true\"",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "kind: ApplicationSet\nmetadata:\n  name: demo-apps\nspec:\n  goTemplate: true\n  generators:\n    - git:\n        repoURL: https://github.com/rosaliei/gitops-monorepo.git\n        revision: main\n        files:\n          - path: \"environments/*/*.yaml\"\n  template:\n    metadata:\n      name: '{{ trimSuffix \".yaml\" .path.filename }}-{{ .path.basename }}'\n      annotations:\n        notifications.argoproj.io/subscribe.on-deployed.slack: gitops-demo\n    spec:\n      project: demo\n      source:\n        repoURL: https://github.com/rosaliei/gitops-monorepo.git\n        targetRevision: main\n        path: charts/app\n        helm:\n          releaseName: '{{ trimSuffix \".yaml\" .path.filename }}'\n          valueFiles:\n            - '../../{{ .path.path }}/{{ .path.filename }}'\n      destination:\n        server: https://kubernetes.default.svc\n        namespace: 'demo-{{ .path.basename }}'\n      syncPolicy:\n        automated:\n          prune: true\n          selfHeal: true\n        syncOptions:\n          - CreateNamespace=true\n        managedNamespaceMetadata:\n          labels:\n            gitops.demo/protected: \"true\"",
   "autoResize": true,
