   "link": null,
   "locked": false,
   "text": "automountServiceAccountToken: false   # the app never calls the Kubernetes API, so give it no token\nsecurityContext:                      # pod-level hardening (the admission policy rejects pods without it)\n  runAsNonRoot: true\n  seccompProfile:\n    type: RuntimeDefault\n...\n  allowPrivilegeEscalation: false\n  readOnlyRootFilesystem: true\n  capabilities:\n    drop: [\"ALL\"]",
   "fontSize": 18,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "automountServiceAccountToken: false   # the app never calls the Kubernetes API, so give it no token\nsecurityContext:                      # pod-level hardening (the admission policy rejects pods without it)\n  runAsNonRoot: true\n  seccompProfile:\n    type: RuntimeDefault\n...\n  allowPrivilegeEscalation: false\n  readOnlyRootFilesystem: true\n  capabilities:\n    drop: [\"ALL\"]",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
