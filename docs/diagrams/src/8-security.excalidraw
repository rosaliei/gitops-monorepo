   "text": "validations:            (CEL, excerpt)\n  - expression: \"...containers.all(c,\n        c.image.contains(':') &&\n        !c.image.endsWith(':latest'))\"\n  - expression: \"...containers.all(c,\n        has(c.resources.limits) &&\n        'memory' in c.resources.limits)\"\n  - expression: \"...securityContext.runAsNonRoot\"\n  - expression: \"...!c.securityContext.privileged\"",
