   "text": "scan() { docker run ... \"$TRIVY_IMAGE\" image \\\n    --quiet --ignore-unfixed --severity \"$1\" \\\n    --exit-code \"$2\" local/<app>:scan; }\nscan HIGH 0 | tee -a trivy.txt       # report only\nscan CRITICAL 1 | tee -a trivy.txt   # the gate",
   "fontSize": 18,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "scan() { docker run ... \"$TRIVY_IMAGE\" image \\\n    --quiet --ignore-unfixed --severity \"$1\" \\\n    --exit-code \"$2\" local/<app>:scan; }\nscan HIGH 0 | tee -a trivy.txt       # report only\nscan CRITICAL 1 | tee -a trivy.txt   # the gate",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
