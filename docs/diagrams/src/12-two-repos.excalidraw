   "text": "/gitops-apps/                     @rosaliei\n\n# DevOps team: Helm chart, environments, ArgoCD, platform add-ons, infrastructure, scripts\n/gitops-config/                   @rosaliei\n/.github/workflows/config-ci.yaml @rosaliei\n/.github/workflows/promote.yaml   @rosaliei",
