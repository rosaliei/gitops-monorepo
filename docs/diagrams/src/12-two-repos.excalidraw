   "link": null,
   "locked": false,
   "text": "      - name: deploy to dev = commit to Git\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          msg=\"\"\n          for f in .out/images/*.json; do\n            app=$(jq -r .app \"$f\"); tag=$(jq -r .tag \"$f\"); digest=$(jq -r .digest \"$f\")\n            gitops-config/scripts/set-image.sh dev \"$app\" \"$tag\" \"$digest\"\n            msg=\"$msg $app:$tag\"\n          done\n          git add gitops-config/environments/dev\n          git commit -m \"chore(dev): deploy$msg\"",
   "fontSize": 17,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "      - name: deploy to dev = commit to Git\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          msg=\"\"\n          for f in .out/images/*.json; do\n            app=$(jq -r .app \"$f\"); tag=$(jq -r .tag \"$f\"); digest=$(jq -r .digest \"$f\")\n            gitops-config/scripts/set-image.sh dev \"$app\" \"$tag\" \"$digest\"\n            msg=\"$msg $app:$tag\"\n          done\n          git add gitops-config/environments/dev\n          git commit -m \"chore(dev): deploy$msg\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
