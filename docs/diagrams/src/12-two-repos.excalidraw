  {
   "id": "a-DOFek49wmaNvCcb8PZg",
   "type": "text",
   "x": 1834,
   "y": 474,
   "width": 968.016,
   "height": 420,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
