  },
  {
   "id": "o0zWsL5gxfaiZfTo2uxJD",
   "type": "text",
   "x": 540.2367999999998,
   "y": 1695,
   "width": 679.5264000000004,
   "height": 210,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b0Az",
   "roundness": null,
   "seed": 528486212,
   "version": 4,
   "versionNonce": 324972796,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145090813,
   "created": 1791145090813,
   "link": null,
   "locked": false,
   "text": "A. In the devops repo  (CHOSEN)\nshared chart for every app = HOW apps run\ndevelopers never learn Helm\n\nB. In each app repo: when an app needs its own special chart\nC. Published as OCI chart (ghcr.io/.../charts/app:1.0.1),\nGitOps repo pins the version: many teams",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "MdlfNM8TmSA0yhh_vjAk8",
   "originalText": "A. In the devops repo  (CHOSEN)\nshared chart for every app = HOW apps run\ndevelopers never learn Helm\n\nB. In each app repo: when an app needs its own special chart\nC. Published as OCI chart (ghcr.io/.../charts/app:1.0.1),\nGitOps repo pins the version: many teams",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "DoY4Uv2bZr6ofW74HrzuG",
   "type": "text",
   "x": 2333.7024,
   "y": 1695,
   "width": 612.5952000000002,
   "height": 210,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b0AzV",
   "roundness": null,
   "seed": 1455785668,
   "version": 4,
   "versionNonce": 1541270724,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145090813,
   "created": 1791145090813,
   "link": null,
   "locked": false,
   "text": "Why two repos\n\n1. permissions: devs merge code all day,\n   changing prod needs devops review\n2. no CI loops: the bot's commits land in the other repo\n3. clean deploy history: git log environments/\n4. many app repos can feed one GitOps repo",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "vOhbSHuXcdUHINsWYcMJw",
   "originalText": "Why two repos\n\n1. permissions: devs merge code all day,\n   changing prod needs devops review\n2. no CI loops: the bot's commits land in the other repo\n3. clean deploy history: git log environments/\n4. many app repos can feed one GitOps repo",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "LpdmgjnmlHikehiAFyFPd",
   "type": "text",
   "x": 4021.14,
   "y": 1737.5,
   "width": 737.7199999999999,
   "height": 125,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b0B",
   "roundness": null,
   "seed": 91229764,
   "version": 3,
   "versionNonce": 1785921276,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145090813,
   "created": 1791145090813,
   "link": null,
   "locked": false,
   "text": "Interview line\n\"Developers own the code, devops owns how and where it runs.\nThe only bridge is a commit that changes an image tag,\nand ArgoCD only ever reads the GitOps repo.\"",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "2us8F3ncIlODTBcTw7V5Z",
   "originalText": "Interview line\n\"Developers own the code, devops owns how and where it runs.\nThe only bridge is a commit that changes an image tag,\nand ArgoCD only ever reads the GitOps repo.\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  }
 ],
