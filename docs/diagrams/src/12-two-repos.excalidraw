   "seed": 1469507662,
   "version": 3,
   "versionNonce": 2042299410,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791141138055,
   "created": 1791141138055,
   "link": null,
   "locked": false,
   "text": "Interview line\n\"Developers own the code, devops owns how and where it runs.\nThe only bridge is a commit that changes an image tag,\nand ArgoCD only ever reads the config side.\"",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "RKSBNnD98l5sPjJWYR-Um",
   "originalText": "Interview line\n\"Developers own the code, devops owns how and where it runs.\nThe only bridge is a commit that changes an image tag,\nand ArgoCD only ever reads the config side.\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  }
