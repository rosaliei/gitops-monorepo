   "updated": 1791145090813,
   "created": 1791145090811,
   "link": null,
   "locked": false,
   "text": "# Write access to the GitOps repo = a deploy key (SSH) stored as secret GITOPS_DEPLOY_KEY.\n# It can push to that ONE repo only: no API access, cannot open or merge PRs.\n- uses: actions/checkout@v7\n  with:\n    repository: ${{ env.GITOPS_REPO }}\n    ssh-key: ${{ secrets.GITOPS_DEPLOY_KEY }}\n    path: gitops\n\n- name: deploy to dev = commit to the GitOps repo\n  working-directory: gitops\n  run: |\n    git config user.name \"github-actions[bot]\"\n    git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n    msg=\"\"\n    for f in ../.out/images/*.json; do\n      app=$(jq -r .app \"$f\"); tag=$(jq -r .tag \"$f\"); digest=$(jq -r .digest \"$f\")\n      scripts/set-image.sh dev \"$app\" \"$tag\" \"$digest\"\n      msg=\"$msg $app:$tag\"\n    done\n    git add environments/dev\n    git commit -m \"chore(dev): deploy$msg\" -m \"From $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/commit/$GITHUB_SHA\"",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "# Write access to the GitOps repo = a deploy key (SSH) stored as secret GITOPS_DEPLOY_KEY.\n# It can push to that ONE repo only: no API access, cannot open or merge PRs.\n- uses: actions/checkout@v7\n  with:\n    repository: ${{ env.GITOPS_REPO }}\n    ssh-key: ${{ secrets.GITOPS_DEPLOY_KEY }}\n    path: gitops\n\n- name: deploy to dev = commit to the GitOps repo\n  working-directory: gitops\n  run: |\n    git config user.name \"github-actions[bot]\"\n    git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n    msg=\"\"\n    for f in ../.out/images/*.json; do\n      app=$(jq -r .app \"$f\"); tag=$(jq -r .tag \"$f\"); digest=$(jq -r .digest \"$f\")\n      scripts/set-image.sh dev \"$app\" \"$tag\" \"$digest\"\n      msg=\"$msg $app:$tag\"\n    done\n    git add environments/dev\n    git commit -m \"chore(dev): deploy$msg\" -m \"From $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/commit/$GITHUB_SHA\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
