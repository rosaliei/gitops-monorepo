   "text": "ci.yaml: validate + promtool + e2e  (every change, also the bot's commits)\npromotion-pr.yaml: promote/qa-* branch from the app repo -> qa PR\npromote.yaml: qa -> prod with approval",
   "fontSize": 22,
   "baseFontSize": null,
   "fontFamily": 5,
