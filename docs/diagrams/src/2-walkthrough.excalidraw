   "link": null,
   "locked": false,
   "text": "jobs:\n  changes:   # paths-filter -> only changed apps\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  e2e:       # kind cluster + the GitOps repo's chart\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit to the GitOps repo",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "jobs:\n  changes:   # paths-filter -> only changed apps\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  e2e:       # kind cluster + the GitOps repo's chart\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit to the GitOps repo",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
