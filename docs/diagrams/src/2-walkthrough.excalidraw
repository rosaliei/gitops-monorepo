   "text": "# Python (orders-api)\n- if: hashFiles('gitops-apps/<app>/requirements.txt') != ''\n  run: |\n    pip install -r requirements-dev.txt\n    ruff check .\n    pytest -v\n# Node.js (inventory-svc, web-frontend)\n- if: hashFiles('gitops-apps/<app>/package.json') != ''\n  run: npm ci && npm run lint && npm test",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
