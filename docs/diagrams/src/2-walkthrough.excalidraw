   "text": "fix: ... -> patch      feat: ... -> minor\nrelease PR \"orders-api 0.2.0\" (version.txt)\nmerge -> git tag orders-api-v0.2.0\nCI: 0.2.0 not in registry -> tag the build\n    -> PR environments/qa/orders-api.yaml\n         tag: \"0.2.0\"\n         digest: \"sha256:<same bytes as dev>\"\nmerge PR = deploy qa",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fix: ... -> patch      feat: ... -> minor\nrelease PR \"orders-api 0.2.0\" (version.txt)\nmerge -> git tag orders-api-v0.2.0\nCI: 0.2.0 not in registry -> tag the build\n    -> PR environments/qa/orders-api.yaml\n         tag: \"0.2.0\"\n         digest: \"sha256:<same bytes as dev>\"\nmerge PR = deploy qa",
