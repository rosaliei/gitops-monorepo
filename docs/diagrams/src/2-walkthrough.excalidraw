   "text": "apps-ci.yaml               PR checks + main pipeline\n_test.yaml            reusable: lint + unit tests\n_build.yaml           reusable: build, scan, sign\nrelease-please.yaml   semver + CHANGELOG per app\npromote.yaml          prod promotion (approval)\nsecurity.yaml         gitleaks + trivy (+ weekly)\npipeline-health.yaml  daily DORA metrics\nterraform.yaml        gitops-config/infra/eks fmt + validate\nlint-workflows.yaml   actionlint + shellcheck\npr-title.yaml         Conventional Commits check",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "apps-ci.yaml               PR checks + main pipeline\n_test.yaml            reusable: lint + unit tests\n_build.yaml           reusable: build, scan, sign\nrelease-please.yaml   semver + CHANGELOG per app\npromote.yaml          prod promotion (approval)\nsecurity.yaml         gitleaks + trivy (+ weekly)\npipeline-health.yaml  daily DORA metrics\nterraform.yaml        gitops-config/infra/eks fmt + validate\nlint-workflows.yaml   actionlint + shellcheck\npr-title.yaml         Conventional Commits check",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
