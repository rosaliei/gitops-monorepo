   "updated": 1791145053615,
   "created": 1791145053610,
   "link": null,
   "locked": false,
   "text": "APP REPO (gitops-apps)\n  ci.yaml               PR checks + main pipeline\n  _test.yaml / _build.yaml   reusable: test | build, scan, sign\n  release-please.yaml   semver + CHANGELOG per app\nGITOPS REPO (gitops-monorepo)\n  ci.yaml               validate + e2e every config change\n  promotion-pr.yaml     promote/qa-* branch -> qa PR\n  promote.yaml          prod promotion (approval)\n  pipeline-health.yaml  daily DORA metrics\nBOTH: security, lint-workflows, pr-title",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "APP REPO (gitops-apps)\n  ci.yaml               PR checks + main pipeline\n  _test.yaml / _build.yaml   reusable: test | build, scan, sign\n  release-please.yaml   semver + CHANGELOG per app\nGITOPS REPO (gitops-monorepo)\n  ci.yaml               validate + e2e every config change\n  promotion-pr.yaml     promote/qa-* branch -> qa PR\n  promote.yaml          prod promotion (approval)\n  pipeline-health.yaml  daily DORA metrics\nBOTH: security, lint-workflows, pr-title",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
