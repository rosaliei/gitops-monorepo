   "text": "jobs:\n  changes:   # paths-filter -> only changed apps\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  validate:  # helm lint + kubeconform, every env\n  e2e:       # throwaway kind cluster + policy tests\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit gitops-config/environments/dev",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "jobs:\n  changes:   # paths-filter -> only changed apps\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  validate:  # helm lint + kubeconform, every env\n  e2e:       # throwaway kind cluster + policy tests\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit gitops-config/environments/dev",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
