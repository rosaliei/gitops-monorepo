   "text": "kind: ApplicationSet\ngenerators:\n  - git: { files: [ \"environments/*/*.yaml\" ] }\ntemplate:                  # 3 apps x 3 envs = 9\n  name: <app>-<env>\n  source: { path: charts/app, valueFiles: [env] }\n  destination: { namespace: demo-<env> }\n  syncPolicy:\n    automated: { prune: true, selfHeal: true }\n# admission policy: kubectl edit is DENIED",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "kind: ApplicationSet\ngenerators:\n  - git: { files: [ \"environments/*/*.yaml\" ] }\ntemplate:                  # 3 apps x 3 envs = 9\n  name: <app>-<env>\n  source: { path: charts/app, valueFiles: [env] }\n  destination: { namespace: demo-<env> }\n  syncPolicy:\n    automated: { prune: true, selfHeal: true }\n# admission policy: kubectl edit is DENIED",
