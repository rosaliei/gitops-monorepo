   "text": "1) build linux/amd64, load locally\n2) trivy image --severity CRITICAL \\\n     --ignore-unfixed --exit-code 1    # the gate\n3) main only: push amd64 + arm64\n     tags: sha-<commit>  (+ x.y.z on release)\n     sbom: true   provenance: mode=max\n4) cosign sign ghcr.io/<owner>/<app>@<digest>\n5) hand over { app, tag, digest, new_release }",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1) build linux/amd64, load locally\n2) trivy image --severity CRITICAL \\\n     --ignore-unfixed --exit-code 1    # the gate\n3) main only: push amd64 + arm64\n     tags: sha-<commit>  (+ x.y.z on release)\n     sbom: true   provenance: mode=max\n4) cosign sign ghcr.io/<owner>/<app>@<digest>\n5) hand over { app, tag, digest, new_release }",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
