   "text": "app repo: .github/workflows/ci.yaml  (build + deploy-dev jobs)",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "app repo: .github/workflows/ci.yaml  (build + deploy-dev jobs)",
   "autoResize": true,
   "lineHeight": 1.2,
   "labelPosition": null
  },
  {
   "id": "i7t0p7wpxcn4OMXLL1Xpv",
   "type": "rectangle",
   "x": 616,
   "y": 1350,
   "width": 1565.34,
   "height": 928.5,
   "angle": 0,
   "strokeColor": "#dee2e6",
   "backgroundColor": "#f8f9fa",
