  {
   "id": "Zn2ERunB5uey-BQSPQXMW",
   "type": "text",
   "x": 2014,
   "y": 1360,
   "width": 1197.1835999999996,
   "height": 832.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
