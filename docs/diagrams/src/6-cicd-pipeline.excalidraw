  {
   "id": "xV9taR2EbCjn18AppVFA5",
   "type": "text",
   "x": 634,
   "y": 1360,
   "width": 1189.8902000000012,
   "height": 902.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b5c",
   "roundness": null,
   "seed": 938963342,
   "version": 3,
   "versionNonce": 361039698,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145062865,
   "created": 1791145062859,
   "link": null,
   "locked": false,
   "text": "  build:\n    needs: [changes, test, e2e]             # only build if tests and e2e passed\n    if: needs.changes.outputs.apps != '[]'\n    strategy:\n      fail-fast: false\n      matrix:\n        app: ${{ fromJSON(needs.changes.outputs.apps) }}\n    name: build (${{ matrix.app }})\n    permissions:\n      contents: read\n      packages: write                       # push images to ghcr.io\n      id-token: write                       # keyless cosign signing (GitHub OIDC)\n    uses: ./.github/workflows/_build.yaml\n    with:\n      app: ${{ matrix.app }}\n      push: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/main' }}  # PRs build + scan only; main also pushes\n\n  # Job 5: \"deploy\" = commit the new tag+digest into the GitOps repo (environments/dev). ArgoCD does the rest.\n  deploy-dev:\n    name: deploy dev (+ qa branch on release)\n    needs: build\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'  # never on PRs\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/download-artifact@v8\n        with:\n          pattern: image-*                  # one small JSON per built app: app, tag, digest, version\n          path: .out/images\n          merge-multiple: true\n\n      # Write access to the GitOps repo = a deploy key (SSH) stored as secret GITOPS_DEPLOY_KEY.\n      # It can push to that ONE repo only: no API access, cannot open or merge PRs.\n      - uses: actions/checkout@v7\n        with:\n          repository: ${{ env.GITOPS_REPO }}\n          ssh-key: ${{ secrets.GITOPS_DEPLOY_KEY }}\n          path: gitops",
   "fontSize": 19,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "  build:\n    needs: [changes, test, e2e]             # only build if tests and e2e passed\n    if: needs.changes.outputs.apps != '[]'\n    strategy:\n      fail-fast: false\n      matrix:\n        app: ${{ fromJSON(needs.changes.outputs.apps) }}\n    name: build (${{ matrix.app }})\n    permissions:\n      contents: read\n      packages: write                       # push images to ghcr.io\n      id-token: write                       # keyless cosign signing (GitHub OIDC)\n    uses: ./.github/workflows/_build.yaml\n    with:\n      app: ${{ matrix.app }}\n      push: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/main' }}  # PRs build + scan only; main also pushes\n\n  # Job 5: \"deploy\" = commit the new tag+digest into the GitOps repo (environments/dev). ArgoCD does the rest.\n  deploy-dev:\n    name: deploy dev (+ qa branch on release)\n    needs: build\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'  # never on PRs\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/download-artifact@v8\n        with:\n          pattern: image-*                  # one small JSON per built app: app, tag, digest, version\n          path: .out/images\n          merge-multiple: true\n\n      # Write access to the GitOps repo = a deploy key (SSH) stored as secret GITOPS_DEPLOY_KEY.\n      # It can push to that ONE repo only: no API access, cannot open or merge PRs.\n      - uses: actions/checkout@v7\n        with:\n          repository: ${{ env.GITOPS_REPO }}\n          ssh-key: ${{ secrets.GITOPS_DEPLOY_KEY }}\n          path: gitops",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
