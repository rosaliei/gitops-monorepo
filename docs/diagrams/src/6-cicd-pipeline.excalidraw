  {
   "id": "Fy6FnbXrfIa2jph11J4xq",
   "type": "text",
   "x": 2014,
   "y": 1360,
   "width": 1197.1835999999996,
   "height": 900,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b5j",
   "roundness": null,
   "seed": 705150866,
   "version": 3,
   "versionNonce": 171497870,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145062865,
   "created": 1791145062859,
   "link": null,
   "locked": false,
   "text": "      # 1) Build for amd64 and load it locally so we can scan before anything is published.\n      - name: build (for scanning)\n        uses: docker/build-push-action@v7\n        with:\n          context: ${{ inputs.app }}\n          platforms: linux/amd64\n          load: true                        # keep the image in the local Docker, do NOT push yet\n      ...\n      # 2) Gate: fail on CRITICAL vulnerabilities that have a fix available. HIGH is reported only.\n      - name: scan (trivy)\n        run: |\n          scan() { docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\\n                     -v \"$HOME/.cache/trivy:/root/.cache/trivy\" \"$TRIVY_IMAGE\" image \\\n                     --quiet --ignore-unfixed --severity \"$1\" --exit-code \"$2\" local/${{ inputs.app }}:scan; }\n          touch trivy.txt\n          report() { { echo \"### ${{ inputs.app }} - image scan\"; echo '```'; tail -n 30 trivy.txt; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"; }\n          trap report EXIT\n          scan HIGH 0 | tee -a trivy.txt\n          scan CRITICAL 1 | tee -a trivy.txt\n      ...\n        name: is this a new release?\n        # If the version tag already exists, this is just a normal build (sha tag only).\n        id: release\n        run: |\n          image=\"${{ steps.meta.outputs.image }}\"; sha_tag=\"${{ steps.meta.outputs.sha_tag }}\"; version=\"${{ steps.meta.outputs.version }}\"\n          if docker buildx imagetools inspect \"$image:$version\" >/dev/null 2>&1; then\n            printf 'new=false\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag\" \"$sha_tag\" >> \"$GITHUB_OUTPUT\"\n          else\n            printf 'new=true\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag,$image:$version\" \"$version\" >> \"$GITHUB_OUTPUT\"\n          fi\n      ...\n      # 4) Sign the digest (keyless, Sigstore). Verify with:\n      #    cosign verify ghcr.io/<owner>/<app>@<digest> \\\n      #      --certificate-identity-regexp 'https://github.com/<owner>/gitops-apps/.*' \\\n      #      --certificate-oidc-issuer https://token.actions.githubusercontent.com\n      - if: inputs.push\n        uses: sigstore/cosign-installer@v4.1.2\n      - if: inputs.push\n        name: sign\n        run: cosign sign --yes \"${{ steps.meta.outputs.image }}@${{ steps.push.outputs.digest }}\"",
   "fontSize": 18,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "      # 1) Build for amd64 and load it locally so we can scan before anything is published.\n      - name: build (for scanning)\n        uses: docker/build-push-action@v7\n        with:\n          context: ${{ inputs.app }}\n          platforms: linux/amd64\n          load: true                        # keep the image in the local Docker, do NOT push yet\n      ...\n      # 2) Gate: fail on CRITICAL vulnerabilities that have a fix available. HIGH is reported only.\n      - name: scan (trivy)\n        run: |\n          scan() { docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\\n                     -v \"$HOME/.cache/trivy:/root/.cache/trivy\" \"$TRIVY_IMAGE\" image \\\n                     --quiet --ignore-unfixed --severity \"$1\" --exit-code \"$2\" local/${{ inputs.app }}:scan; }\n          touch trivy.txt\n          report() { { echo \"### ${{ inputs.app }} - image scan\"; echo '```'; tail -n 30 trivy.txt; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"; }\n          trap report EXIT\n          scan HIGH 0 | tee -a trivy.txt\n          scan CRITICAL 1 | tee -a trivy.txt\n      ...\n        name: is this a new release?\n        # If the version tag already exists, this is just a normal build (sha tag only).\n        id: release\n        run: |\n          image=\"${{ steps.meta.outputs.image }}\"; sha_tag=\"${{ steps.meta.outputs.sha_tag }}\"; version=\"${{ steps.meta.outputs.version }}\"\n          if docker buildx imagetools inspect \"$image:$version\" >/dev/null 2>&1; then\n            printf 'new=false\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag\" \"$sha_tag\" >> \"$GITHUB_OUTPUT\"\n          else\n            printf 'new=true\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag,$image:$version\" \"$version\" >> \"$GITHUB_OUTPUT\"\n          fi\n      ...\n      # 4) Sign the digest (keyless, Sigstore). Verify with:\n      #    cosign verify ghcr.io/<owner>/<app>@<digest> \\\n      #      --certificate-identity-regexp 'https://github.com/<owner>/gitops-apps/.*' \\\n      #      --certificate-oidc-issuer https://token.actions.githubusercontent.com\n      - if: inputs.push\n        uses: sigstore/cosign-installer@v4.1.2\n      - if: inputs.push\n        name: sign\n        run: cosign sign --yes \"${{ steps.meta.outputs.image }}@${{ steps.push.outputs.digest }}\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
