   "seed": 1459103044,
   "version": 3,
   "versionNonce": 1790186180,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791141193270,
   "created": 1791141193266,
   "link": null,
   "locked": false,
   "text": "  build:\n    needs: [changes, test, e2e]\n    if: needs.changes.outputs.apps != '[]'\n    strategy:\n      fail-fast: false\n      matrix:\n        app: ${{ fromJSON(needs.changes.outputs.apps) }}\n    name: build (${{ matrix.app }})\n    permissions:\n      contents: read\n      packages: write\n      id-token: write\n    uses: ./.github/workflows/_build.yaml\n    with:\n      app: ${{ matrix.app }}\n      push: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/main' }}\n\n  deploy-dev:\n    name: deploy dev (+ qa PR on release)\n    needs: build\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: write        # commit to gitops-config/environments/dev\n      pull-requests: write   # open the qa promotion PR",
   "fontSize": 19,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "  build:\n    needs: [changes, test, e2e]\n    if: needs.changes.outputs.apps != '[]'\n    strategy:\n      fail-fast: false\n      matrix:\n        app: ${{ fromJSON(needs.changes.outputs.apps) }}\n    name: build (${{ matrix.app }})\n    permissions:\n      contents: read\n      packages: write\n      id-token: write\n    uses: ./.github/workflows/_build.yaml\n    with:\n      app: ${{ matrix.app }}\n      push: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/main' }}\n\n  deploy-dev:\n    name: deploy dev (+ qa PR on release)\n    needs: build\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: write        # commit to gitops-config/environments/dev\n      pull-requests: write   # open the qa promotion PR",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
