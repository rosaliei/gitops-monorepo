   "link": null,
   "locked": false,
   "text": "      - name: build (for scanning)\n        uses: docker/build-push-action@v7\n        with:\n          context: apps/${{ inputs.app }}\n          platforms: linux/amd64\n          load: true\n          tags: local/${{ inputs.app }}:scan\n          cache-from: type=gha,scope=${{ inputs.app }}\n          cache-to: type=gha,scope=${{ inputs.app }},mode=max\n\n      # 2) Gate: fail on CRITICAL vulnerabilities that have a fix available. HIGH is reported only.\n      - name: scan (trivy)\n        run: |\n          scan() { docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\\n                     -v \"$HOME/.cache/trivy:/root/.cache/trivy\" \"$TRIVY_IMAGE\" image \\\n                     --quiet --ignore-unfixed --severity \"$1\" --exit-code \"$2\" local/${{ inputs.app }}:scan; }\n          touch trivy.txt\n          report() { { echo \"### ${{ inputs.app }} - image scan\"; echo '```'; tail -n 30 trivy.txt; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"; }\n          trap report EXIT\n          scan HIGH 0 | tee -a trivy.txt\n      ...\n      - if: inputs.push\n        name: is this a new release?\n        id: release\n        run: |\n          image=\"${{ steps.meta.outputs.image }}\"; sha_tag=\"${{ steps.meta.outputs.sha_tag }}\"; version=\"${{ steps.meta.outputs.version }}\"\n          if docker buildx imagetools inspect \"$image:$version\" >/dev/null 2>&1; then\n            printf 'new=false\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag\" \"$sha_tag\" >> \"$GITHUB_OUTPUT\"\n          else\n            printf 'new=true\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag,$image:$version\" \"$version\" >> \"$GITHUB_OUTPUT\"\n          fi\n      ...\n      - if: inputs.push\n        uses: sigstore/cosign-installer@v4.1.2\n      - if: inputs.push\n        name: sign\n        run: cosign sign --yes \"${{ steps.meta.outputs.image }}@${{ steps.push.outputs.digest }}\"",
   "fontSize": 18,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "      - name: build (for scanning)\n        uses: docker/build-push-action@v7\n        with:\n          context: apps/${{ inputs.app }}\n          platforms: linux/amd64\n          load: true\n          tags: local/${{ inputs.app }}:scan\n          cache-from: type=gha,scope=${{ inputs.app }}\n          cache-to: type=gha,scope=${{ inputs.app }},mode=max\n\n      # 2) Gate: fail on CRITICAL vulnerabilities that have a fix available. HIGH is reported only.\n      - name: scan (trivy)\n        run: |\n          scan() { docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\\n                     -v \"$HOME/.cache/trivy:/root/.cache/trivy\" \"$TRIVY_IMAGE\" image \\\n                     --quiet --ignore-unfixed --severity \"$1\" --exit-code \"$2\" local/${{ inputs.app }}:scan; }\n          touch trivy.txt\n          report() { { echo \"### ${{ inputs.app }} - image scan\"; echo '```'; tail -n 30 trivy.txt; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"; }\n          trap report EXIT\n          scan HIGH 0 | tee -a trivy.txt\n      ...\n      - if: inputs.push\n        name: is this a new release?\n        id: release\n        run: |\n          image=\"${{ steps.meta.outputs.image }}\"; sha_tag=\"${{ steps.meta.outputs.sha_tag }}\"; version=\"${{ steps.meta.outputs.version }}\"\n          if docker buildx imagetools inspect \"$image:$version\" >/dev/null 2>&1; then\n            printf 'new=false\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag\" \"$sha_tag\" >> \"$GITHUB_OUTPUT\"\n          else\n            printf 'new=true\\ntags=%s\\napp_version=%s\\n' \"$image:$sha_tag,$image:$version\" \"$version\" >> \"$GITHUB_OUTPUT\"\n          fi\n      ...\n      - if: inputs.push\n        uses: sigstore/cosign-installer@v4.1.2\n      - if: inputs.push\n        name: sign\n        run: cosign sign --yes \"${{ steps.meta.outputs.image }}@${{ steps.push.outputs.digest }}\"",
   "autoResize": true,
