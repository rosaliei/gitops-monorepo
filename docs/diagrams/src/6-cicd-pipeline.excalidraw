  {
   "id": "wiHwvWX4a08P_aAngxXKO",
   "type": "text",
   "x": 634,
   "y": 1360,
   "width": 807.6253999999998,
   "height": 617.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
