   "text": "GITOPS REPO (gitops-monorepo):  ci.yaml  -  every config change, incl. the bot's dev commits\nvalidate:  helm lint + template + kubeconform + promtool alert rules\ne2e (kind):  same throwaway-cluster test\nno build, no deploy: ArgoCD applies config changes itself",
   "fontSize": 22,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "pILLJyD8pZnDOsW0V2hrL",
   "originalText": "GITOPS REPO (gitops-monorepo):  ci.yaml  -  every config change, incl. the bot's dev commits\nvalidate:  helm lint + template + kubeconform + promtool alert rules\ne2e (kind):  same throwaway-cluster test\nno build, no deploy: ArgoCD applies config changes itself",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
