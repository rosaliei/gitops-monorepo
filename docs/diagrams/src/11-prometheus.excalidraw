   "text": "kind: ServiceMonitor                        # \"Prometheus, please scrape this Service\"\nmetadata:\n  name: argocd-application-controller\n  namespace: argocd                         # lives next to the Service it points at\nspec:\n  selector:                                 # find the Service by its labels\n    matchLabels:\n      app.kubernetes.io/name: argocd-metrics\n      app.kubernetes.io/component: application-controller\n  endpoints:\n    - port: http-metrics                    # port NAME on that Service\n      interval: 30s                         # scrape every 30 seconds",
   "fontSize": 17,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "kind: ServiceMonitor                        # \"Prometheus, please scrape this Service\"\nmetadata:\n  name: argocd-application-controller\n  namespace: argocd                         # lives next to the Service it points at\nspec:\n  selector:                                 # find the Service by its labels\n    matchLabels:\n      app.kubernetes.io/name: argocd-metrics\n      app.kubernetes.io/component: application-controller\n  endpoints:\n    - port: http-metrics                    # port NAME on that Service\n      interval: 30s                         # scrape every 30 seconds",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
