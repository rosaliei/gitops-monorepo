   "link": null,
   "locked": false,
   "text": "        - alert: HighLatencyP99\n          expr: job:http_request_duration_seconds:p99_5m > 1\n          for: 10m\n          labels:\n            severity: warning\n          annotations:\n            summary: \"{{ $labels.job }} p99 latency above 1s in {{ $labels.namespace }}\"\n            description: \"1 in 100 requests is slower than 1s: the slow tail that users notice first.\"",
   "fontSize": 17,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "        - alert: HighLatencyP99\n          expr: job:http_request_duration_seconds:p99_5m > 1\n          for: 10m\n          labels:\n            severity: warning\n          annotations:\n            summary: \"{{ $labels.job }} p99 latency above 1s in {{ $labels.namespace }}\"\n            description: \"1 in 100 requests is slower than 1s: the slow tail that users notice first.\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
