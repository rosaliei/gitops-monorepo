  {
   "id": "2ulECvyNhX8KYr7ZD4xid",
   "type": "text",
   "x": 4934,
   "y": 420,
   "width": 835.2160000000003,
   "height": 340,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bBE",
   "roundness": null,
   "seed": 404694094,
   "version": 3,
   "versionNonce": 1088281294,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145083914,
   "created": 1791145083910,
   "link": null,
   "locked": false,
   "text": "    - record: job:http_error_ratio:rate5m  # recording rule: pre-computes a query and saves it as a new metric\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[5m]))\n          / sum by (namespace, job) (rate(http_requests_total[5m]))\n    - record: job:http_error_ratio:rate1h\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[1h]))\n          / sum by (namespace, job) (rate(http_requests_total[1h]))\n    - alert: ErrorBudgetBurnFast        # alert rule: fires when expr returns something\n      expr: job:http_error_ratio:rate1h > (14.4 * 0.01) and job:http_error_ratio:rate5m > (14.4 * 0.01)\n      for: 2m                          # must stay true for 2 minutes before it fires (no flapping)\n      labels:\n        severity: critical             # Alertmanager routes by severity (critical = page someone)\n      annotations:\n        summary: \"{{ $labels.job }} in {{ $labels.namespace }} is burning its error budget fast\"\n        description: \"Error ratio is {{ $value | humanizePercentage }} (SLO allows 1%).\"\n        # runbook_url: the on-call engineer clicks this from the alert",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    - record: job:http_error_ratio:rate5m  # recording rule: pre-computes a query and saves it as a new metric\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[5m]))\n          / sum by (namespace, job) (rate(http_requests_total[5m]))\n    - record: job:http_error_ratio:rate1h\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[1h]))\n          / sum by (namespace, job) (rate(http_requests_total[1h]))\n    - alert: ErrorBudgetBurnFast        # alert rule: fires when expr returns something\n      expr: job:http_error_ratio:rate1h > (14.4 * 0.01) and job:http_error_ratio:rate5m > (14.4 * 0.01)\n      for: 2m                          # must stay true for 2 minutes before it fires (no flapping)\n      labels:\n        severity: critical             # Alertmanager routes by severity (critical = page someone)\n      annotations:\n        summary: \"{{ $labels.job }} in {{ $labels.namespace }} is burning its error budget fast\"\n        description: \"Error ratio is {{ $value | humanizePercentage }} (SLO allows 1%).\"\n        # runbook_url: the on-call engineer clicks this from the alert",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
