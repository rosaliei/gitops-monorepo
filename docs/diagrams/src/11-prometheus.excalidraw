  },
  {
   "id": "rnWYL83_o-Yik_cYve435",
   "type": "text",
   "x": 4986.1533,
   "y": 2570.925,
   "width": 867.6934000000005,
   "height": 143.75,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b5V",
   "roundness": null,
   "seed": 1737768914,
   "version": 4,
   "versionNonce": 1859309454,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791090719615,
   "created": 1791090719614,
   "link": null,
   "locked": false,
   "text": "Interview line\n\"I alert on p95 and p99, not the average. p99 is what the slowest 1% feel,\nand averages hide it. Prometheus estimates percentiles from histogram buckets,\nso I choose bucket boundaries around my SLO, and the alert rules\nare unit-tested with promtool in CI.\"",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "LhTmNMaqydSV1g0Dx9Y5m",
   "originalText": "Interview line\n\"I alert on p95 and p99, not the average. p99 is what the slowest 1% feel,\nand averages hide it. Prometheus estimates percentiles from histogram buckets,\nso I choose bucket boundaries around my SLO, and the alert rules\nare unit-tested with promtool in CI.\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  }
 ],
 "sceneVersion": "4b712b42",
