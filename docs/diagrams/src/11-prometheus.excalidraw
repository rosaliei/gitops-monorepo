  {
   "id": "Xg96ru-qvDlbvPQXO2C_r",
   "type": "text",
   "x": 554.5188,
   "y": 2567.5,
   "width": 730.9623999999999,
   "height": 105,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b5S",
   "roundness": null,
   "seed": 1465732754,
   "version": 4,
   "versionNonce": 159368402,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791090719615,
   "created": 1791090719613,
   "link": null,
   "locked": false,
   "text": "average = ~100 ms   ->  looks fine\np99 = 5 s   ->  shows what the slowest 1% of users feel\nrule: alert on percentiles, never on the average",
   "fontSize": 28,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "LgJVzH19u3SMDaA1gy6YF",
   "originalText": "average = ~100 ms   ->  looks fine\np99 = 5 s   ->  shows what the slowest 1% of users feel\nrule: alert on percentiles, never on the average",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "i1c3_r4aMXAV3Daas-j9o",
   "type": "text",
   "x": 2699.302,
   "y": 2255,
   "width": 781.3959999999998,
   "height": 165,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b5T",
   "roundness": null,
   "seed": 261729362,
   "version": 4,
   "versionNonce": 585705806,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791090719615,
   "created": 1791090719613,
   "link": null,
   "locked": false,
   "text": "histogram_quantile(0.99, ...) works on BUCKETS, not on single requests\n\napp counts requests per bucket:  le=0.005  le=0.01  ...  le=2.5  le=5  le=+Inf\nPrometheus finds the bucket that holds the 99th request\nand interpolates inside it  ->  an ESTIMATE\nbucket boundaries decide how precise p99 can be",
   "fontSize": 22,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "mro46Axg9bTK0wD_fBXoX",
   "originalText": "histogram_quantile(0.99, ...) works on BUCKETS, not on single requests\n\napp counts requests per bucket:  le=0.005  le=0.01  ...  le=2.5  le=5  le=+Inf\nPrometheus finds the bucket that holds the 99th request\nand interpolates inside it  ->  an ESTIMATE\nbucket boundaries decide how precise p99 can be",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "0VbD3IMyhwrGEaEpVOvpi",
   "type": "text",
   "x": 2063.643,
   "y": 2353.2262874999997,
   "width": 69.274,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
