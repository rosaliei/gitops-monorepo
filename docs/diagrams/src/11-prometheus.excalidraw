   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145083914,
   "created": 1791145083910,
   "link": null,
   "locked": false,
   "text": "prometheus:\n  prometheusSpec:\n    # Pick up ServiceMonitors / rules from every namespace, not just this Helm release.\n    serviceMonitorSelectorNilUsesHelmValues: false  # without this, our ServiceMonitors in demo-* would be ignored\n    podMonitorSelectorNilUsesHelmValues: false\n    ruleSelectorNilUsesHelmValues: false    # same for PrometheusRules (alerts.yaml)\n    retention: 2d                           # keep 2 days of metrics (laptop disk)",
   "fontSize": 19,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "prometheus:\n  prometheusSpec:\n    # Pick up ServiceMonitors / rules from every namespace, not just this Helm release.\n    serviceMonitorSelectorNilUsesHelmValues: false  # without this, our ServiceMonitors in demo-* would be ignored\n    podMonitorSelectorNilUsesHelmValues: false\n    ruleSelectorNilUsesHelmValues: false    # same for PrometheusRules (alerts.yaml)\n    retention: 2d                           # keep 2 days of metrics (laptop disk)",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
