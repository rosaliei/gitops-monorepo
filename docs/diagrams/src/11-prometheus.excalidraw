   "created": 1791145086946,
   "link": null,
   "locked": false,
   "text": "        - record: job:http_request_duration_seconds:p50_5m\n          expr: histogram_quantile(0.50, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))\n        - record: job:http_request_duration_seconds:p95_5m\n          expr: histogram_quantile(0.95, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))\n        - record: job:http_request_duration_seconds:p99_5m\n          expr: histogram_quantile(0.99, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))",
   "fontSize": 17,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "        - record: job:http_request_duration_seconds:p50_5m\n          expr: histogram_quantile(0.50, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))\n        - record: job:http_request_duration_seconds:p95_5m\n          expr: histogram_quantile(0.95, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))\n        - record: job:http_request_duration_seconds:p99_5m\n          expr: histogram_quantile(0.99, sum by (le, namespace, job) (rate(http_request_duration_seconds_bucket[5m])))",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
