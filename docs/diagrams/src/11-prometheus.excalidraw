   "link": null,
   "locked": false,
   "text": "REQUESTS = Counter(\"http_requests_total\", \"HTTP requests\", [\"method\", \"route\", \"status\"])\nLATENCY = Histogram(\"http_request_duration_seconds\", \"HTTP request latency\", [\"method\", \"route\"])\nBUILD_INFO = Gauge(\"app_build_info\", \"Build information\", [\"service\", \"version\", \"commit\"])\nBUILD_INFO.labels(SERVICE, VERSION, COMMIT).set(1)",
   "fontSize": 19,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "REQUESTS = Counter(\"http_requests_total\", \"HTTP requests\", [\"method\", \"route\", \"status\"])\nLATENCY = Histogram(\"http_request_duration_seconds\", \"HTTP request latency\", [\"method\", \"route\"])\nBUILD_INFO = Gauge(\"app_build_info\", \"Build information\", [\"service\", \"version\", \"commit\"])\nBUILD_INFO.labels(SERVICE, VERSION, COMMIT).set(1)",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
