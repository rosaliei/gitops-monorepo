   "seed": 2021907268,
   "version": 4,
   "versionNonce": 1931145596,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145086949,
   "created": 1791145086948,
   "link": null,
   "locked": false,
   "text": "Interview line\n\"I alert on p95 and p99, not the average. p99 is what the slowest 1% feel,\nand averages hide it. Prometheus estimates percentiles from histogram buckets,\nso I choose bucket boundaries around my SLO, and the alert rules\nare unit-tested with promtool in CI.\"",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "WTVj9WDZTr9F2bWFR_xAr",
   "originalText": "Interview line\n\"I alert on p95 and p99, not the average. p99 is what the slowest 1% feel,\nand averages hide it. Prometheus estimates percentiles from histogram buckets,\nso I choose bucket boundaries around my SLO, and the alert rules\nare unit-tested with promtool in CI.\"",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  }
 ],
