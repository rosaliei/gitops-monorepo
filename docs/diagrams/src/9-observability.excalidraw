   "text": "SLO: 99% of requests succeed (30 days)  ->  error budget = 1%",
   "fontSize": 19,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SLO: 99% of requests succeed (30 days)  ->  error budget = 1%",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "CE_xEwNvXtUkB6HOQIFRw",
   "type": "rectangle",
   "x": 1436,
   "y": 324,
   "width": 1169.065,
   "height": 493.5,
   "angle": 0,
   "strokeColor": "#dee2e6",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b1p",
   "roundness": {
    "type": 3
   },
   "seed": 183173330,
   "version": 3,
   "versionNonce": 1770753106,
   "isDeleted": false,
   "boundElements": [],
