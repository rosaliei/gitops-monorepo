   "isDeleted": false,
   "boundElements": null,
   "updated": 1791141205899,
   "created": 1791141205894,
   "link": null,
   "locked": false,
   "text": "- name: slo.availability\n  # SLO: 99% of requests succeed (non-5xx) over 30 days -> error budget = 1%.\n  # Multi-window burn rate: page when we burn budget 14.4x too fast (2% of the 30-day budget\n  # in 1 hour), confirmed by the last 5 minutes so the alert clears quickly after a fix.\n  rules:\n    - record: job:http_error_ratio:rate5m\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[5m]))\n          / sum by (namespace, job) (rate(http_requests_total[5m]))\n    - record: job:http_error_ratio:rate1h\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[1h]))\n          / sum by (namespace, job) (rate(http_requests_total[1h]))\n    - alert: ErrorBudgetBurnFast\n      expr: job:http_error_ratio:rate1h > (14.4 * 0.01) and job:http_error_ratio:rate5m > (14.4 * 0.01)\n      for: 2m\n      labels:\n        severity: critical\n      annotations:\n        summary: \"{{ $labels.job }} in {{ $labels.namespace }} is burning its error budget fast\"\n        description: \"Error ratio is {{ $value | humanizePercentage }} (SLO allows 1%).\"\n        runbook_url: https://github.com/rosaliei/gitops-monorepo/blob/main/docs/runbooks/error-budget-burn.md",
   "fontSize": 17,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "- name: slo.availability\n  # SLO: 99% of requests succeed (non-5xx) over 30 days -> error budget = 1%.\n  # Multi-window burn rate: page when we burn budget 14.4x too fast (2% of the 30-day budget\n  # in 1 hour), confirmed by the last 5 minutes so the alert clears quickly after a fix.\n  rules:\n    - record: job:http_error_ratio:rate5m\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[5m]))\n          / sum by (namespace, job) (rate(http_requests_total[5m]))\n    - record: job:http_error_ratio:rate1h\n      expr: |\n        sum by (namespace, job) (rate(http_requests_total{status=~\"5..\"}[1h]))\n          / sum by (namespace, job) (rate(http_requests_total[1h]))\n    - alert: ErrorBudgetBurnFast\n      expr: job:http_error_ratio:rate1h > (14.4 * 0.01) and job:http_error_ratio:rate5m > (14.4 * 0.01)\n      for: 2m\n      labels:\n        severity: critical\n      annotations:\n        summary: \"{{ $labels.job }} in {{ $labels.namespace }} is burning its error budget fast\"\n        description: \"Error ratio is {{ $value | humanizePercentage }} (SLO allows 1%).\"\n        runbook_url: https://github.com/rosaliei/gitops-monorepo/blob/main/docs/runbooks/error-budget-burn.md",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
