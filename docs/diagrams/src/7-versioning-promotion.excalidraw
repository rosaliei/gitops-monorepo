  {
   "id": "FoRDjzb8GwEJHJ8ecIziX",
   "type": "text",
   "x": 3054,
   "y": 1250,
   "width": 812.8949999999998,
   "height": 318.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
