   "updated": 1791141197307,
   "created": 1791141197305,
   "link": null,
   "locked": false,
   "text": "if [ -z \"$VERSION\" ]; then\n  tag=$(field tag qa); digest=$(field digest qa); source=\"qa\"\nelse\n  tag=\"$VERSION\"; source=\"registry\"\nfi\n[[ \"$tag\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo \"::error::'$tag' is not a release version (x.y.z)\"; exit 1; }\n\n# The image must exist. Take the digest from the registry if we do not have it yet.\nimage=\"ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/$APP\"\nregistry_digest=$(docker buildx imagetools inspect \"$image:$tag\" --format '{{json .Manifest}}' | jq -r .digest) \\\n  || { echo \"::error::$image:$tag not found in the registry\"; exit 1; }\ndigest=\"${digest:-$registry_digest}\"\n[ \"$digest\" = \"$registry_digest\" ] || { echo \"::error::digest mismatch for $tag - the tag was overwritten?\"; exit 1; }\n\nif [ \"$tag\" = \"$current\" ]; then kind=\"no-op\"\nelif [ \"$(printf '%s\\n%s\\n' \"$tag\" \"$current\" | sort -V | tail -1)\" = \"$current\" ]; then kind=\"rollback\"\nelse kind=\"promote\"; fi",
   "fontSize": 15,
   "baseFontSize": null,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "if [ -z \"$VERSION\" ]; then\n  tag=$(field tag qa); digest=$(field digest qa); source=\"qa\"\nelse\n  tag=\"$VERSION\"; source=\"registry\"\nfi\n[[ \"$tag\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo \"::error::'$tag' is not a release version (x.y.z)\"; exit 1; }\n\n# The image must exist. Take the digest from the registry if we do not have it yet.\nimage=\"ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/$APP\"\nregistry_digest=$(docker buildx imagetools inspect \"$image:$tag\" --format '{{json .Manifest}}' | jq -r .digest) \\\n  || { echo \"::error::$image:$tag not found in the registry\"; exit 1; }\ndigest=\"${digest:-$registry_digest}\"\n[ \"$digest\" = \"$registry_digest\" ] || { echo \"::error::digest mismatch for $tag - the tag was overwritten?\"; exit 1; }\n\nif [ \"$tag\" = \"$current\" ]; then kind=\"no-op\"\nelif [ \"$(printf '%s\\n%s\\n' \"$tag\" \"$current\" | sort -V | tail -1)\" = \"$current\" ]; then kind=\"rollback\"\nelse kind=\"promote\"; fi",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
