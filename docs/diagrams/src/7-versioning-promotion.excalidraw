   "text": "Rules\n- dev gets sha-<commit> builds, qa/prod only x.y.z releases\n- a release tag is pushed once, never moved\n- promote copies tag + digest: nothing is rebuilt\n- promote checks the digest still matches the registry",
   "fontSize": 22,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "8kZn_mBX9xa_o0skuGHpu",
   "originalText": "Rules\n- dev gets sha-<commit> builds, qa/prod only x.y.z releases\n- a release tag is pushed once, never moved\n- promote copies tag + digest: nothing is rebuilt\n- promote checks the digest still matches the registry",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
