   "text": "jobs:\n  changes:   # paths-filter -> only the apps that changed\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  validate:  # scripts/validate.sh  helm lint + kubeconform\n  e2e:       # scripts/e2e.sh       throwaway kind cluster\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit to environments/dev",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "jobs:\n  changes:   # paths-filter -> only the apps that changed\n  test:\n    matrix: { app: <changed apps> }\n    uses: ./.github/workflows/_test.yaml\n  validate:  # scripts/validate.sh  helm lint + kubeconform\n  e2e:       # scripts/e2e.sh       throwaway kind cluster\n  build:\n    needs: [changes, test, e2e]\n    uses: ./.github/workflows/_build.yaml\n    with: { push: <true only on main> }\n  deploy-dev:  # main only -> commit to environments/dev",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
