   "link": null,
   "locked": false,
   "text": "ci.yaml               PR checks + main pipeline\n_test.yaml            reusable: lint + unit tests\n_build.yaml           reusable: build, scan, sign\nrelease-please.yaml   semver + CHANGELOG per app\npromote.yaml          prod promotion (approval)\nsecurity.yaml         gitleaks + trivy (+ weekly)\npipeline-health.yaml  daily DORA metrics\nterraform.yaml        infra/eks fmt + validate\nlint-workflows.yaml   actionlint + shellcheck\npr-title.yaml         Conventional Commits check",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ci.yaml               PR checks + main pipeline\n_test.yaml            reusable: lint + unit tests\n_build.yaml           reusable: build, scan, sign\nrelease-please.yaml   semver + CHANGELOG per app\npromote.yaml          prod promotion (approval)\nsecurity.yaml         gitleaks + trivy (+ weekly)\npipeline-health.yaml  daily DORA metrics\nterraform.yaml        infra/eks fmt + validate\nlint-workflows.yaml   actionlint + shellcheck\npr-title.yaml         Conventional Commits check",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
