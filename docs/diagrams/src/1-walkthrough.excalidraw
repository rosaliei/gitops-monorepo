   "text": "on: workflow_dispatch   inputs: app, version\njobs:\n  plan:        # take qa tag + digest, verify in GHCR\n               # promote | rollback | no-op\n  production:\n    environment: production    # required reviewer\n    steps:\n      - run: scripts/set-image.sh prod <app> <tag> <digest>\n      - uses: peter-evans/create-pull-request@v8\n# rollback = same workflow with an older version",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "on: workflow_dispatch   inputs: app, version\njobs:\n  plan:        # take qa tag + digest, verify in GHCR\n               # promote | rollback | no-op\n  production:\n    environment: production    # required reviewer\n    steps:\n      - run: scripts/set-image.sh prod <app> <tag> <digest>\n      - uses: peter-evans/create-pull-request@v8\n# rollback = same workflow with an older version",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
