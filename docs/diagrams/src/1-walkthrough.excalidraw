   "link": null,
   "locked": false,
   "text": "kind: ApplicationSet\ngenerators:\n  - git: { files: [ path: \"environments/*/*.yaml\" ] }\ntemplate:                      # 3 apps x 3 envs = 9 apps\n  name: <app>-<env>\n  source: { path: charts/app, valueFiles: [<env file>] }\n  destination: { namespace: demo-<env> }\n  syncPolicy:\n    automated: { prune: true, selfHeal: true }\n# admission policy: kubectl edit in demo-* is DENIED",
