   "text": "APP REPO  =  gitops-apps/\nowned by developers: code, tests, Dockerfiles  (ArgoCD never reads it)",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "TbRcSQNv1umohSo9Sou75",
   "originalText": "APP REPO  =  gitops-apps/\nowned by developers: code, tests, Dockerfiles  (ArgoCD never reads it)",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "FOuqXt15wI9DGT8ZsPm6b",
   "type": "text",
   "x": 2479.791,
   "y": 640.5,
   "width": 1220.4180000000001,
   "height": 69,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bAe",
