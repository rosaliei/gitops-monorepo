   "text": "GITOPS REPO  =  github.com/rosaliei/gitops-monorepo\nowned by devops: Helm chart, environments, ArgoCD apps  (ArgoCD reads ONLY this)",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "PR1FR1aXnEcZ9Fl_OrMqm",
   "originalText": "GITOPS REPO  =  github.com/rosaliei/gitops-monorepo\nowned by devops: Helm chart, environments, ArgoCD apps  (ArgoCD reads ONLY this)",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "pFC8jcF7SEnuNqpvMLFH7",
   "type": "text",
   "x": 403.36199999999997,
   "y": 948.75,
   "width": 633.2760000000001,
