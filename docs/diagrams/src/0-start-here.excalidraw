   "text": "APP REPO  =  github.com/rosaliei/gitops-apps\nowned by developers: code, tests, Dockerfiles  (ArgoCD never reads it)",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "T4n6zah13YSXdmpGiZfaa",
   "originalText": "APP REPO  =  github.com/rosaliei/gitops-apps\nowned by developers: code, tests, Dockerfiles  (ArgoCD never reads it)",
