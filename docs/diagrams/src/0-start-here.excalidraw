   "link": null,
   "locked": false,
   "text": "3  Build once, promote the same image\nthe dev image goes to qa and prod\nsame sha256 digest, never rebuilt",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ZnbjA6NKX5EfHSRPNv7at",
