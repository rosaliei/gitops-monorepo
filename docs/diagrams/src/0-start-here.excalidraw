   "text": "1  Deploy = change a file in Git\nenvironments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "plCYexkvXW0bcKebeD724",
   "originalText": "1  Deploy = change a file in Git\nenvironments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "Qb7smlr6fn0ZboIjRIVlD",
   "type": "text",
   "x": 1877.893,
   "y": 948.75,
   "width": 524.214,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b4E",
   "roundness": null,
   "seed": 2115799182,
   "version": 4,
   "versionNonce": 819864082,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791060839854,
   "created": 1791060839850,
   "link": null,
   "locked": false,
   "text": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "X6w_UFuhqlmRIF-JaMCKH",
   "originalText": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
