   "updated": 1791142833051,
   "created": 1791142833046,
   "link": null,
   "locked": false,
   "text": "GITOPS REPO  =  gitops-config/\nowned by devops: Helm chart, environments, ArgoCD apps  (ArgoCD reads ONLY this)",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "Kv_GV7BPF6qjhp-5aGAZE",
   "originalText": "GITOPS REPO  =  gitops-config/\nowned by devops: Helm chart, environments, ArgoCD apps  (ArgoCD reads ONLY this)",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "bUnxc5DCweMxXocKSheTa",
   "type": "text",
   "x": 298.03499999999985,
   "y": 948.75,
   "width": 843.9300000000003,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bAf",
   "roundness": null,
   "seed": 521732292,
   "version": 4,
   "versionNonce": 1353379908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791142833051,
   "created": 1791142833046,
   "link": null,
   "locked": false,
   "text": "1  Deploy = change a file in Git\ngitops-config/environments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n-JAvopZAYYMUMRbMkgTS",
   "originalText": "1  Deploy = change a file in Git\ngitops-config/environments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "rbORHX9IzmfDbp9FWRUxM",
   "type": "text",
   "x": 1877.893,
   "y": 948.75,
   "width": 524.214,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bAg",
   "roundness": null,
   "seed": 692340804,
   "version": 4,
   "versionNonce": 401483260,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791142833051,
   "created": 1791142833046,
   "link": null,
   "locked": false,
   "text": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "HaanYjdtvNtUxRzB8Lgay",
   "originalText": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "7xN3UnTmyt6K3jcKgLXiY",
   "type": "text",
   "x": 3292.166,
   "y": 948.75,
   "width": 535.6679999999999,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bAh",
   "roundness": null,
   "seed": 1838849988,
   "version": 4,
   "versionNonce": 1106003908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791142833051,
   "created": 1791142833046,
   "link": null,
   "locked": false,
   "text": "3  Build once, promote the same image\nthe dev image goes to qa and prod\nsame sha256 digest, never rebuilt",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
