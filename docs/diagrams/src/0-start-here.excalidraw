   "text": "1  Deploy = change a file in Git\ngitops-config/environments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "JXaOPToJet4E8-pK8-7a3",
   "originalText": "1  Deploy = change a file in Git\ngitops-config/environments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "Ud6BkAWMTG1gGyAoEPXMA",
   "type": "text",
   "x": 1877.893,
   "y": 948.75,
   "width": 524.214,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
