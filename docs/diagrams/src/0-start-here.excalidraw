   "link": null,
   "locked": false,
   "text": "1  Deploy = change a file in Git\nenvironments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "79HNxEBJYyV3k1i7SS3ih",
   "originalText": "1  Deploy = change a file in Git\nenvironments/<env>/<app>.yaml  +  git push\nno kubectl apply, no helm upgrade",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "S2O1OHl-uBy7UU8tolJI8",
   "type": "text",
   "x": 1877.893,
   "y": 948.75,
   "width": 524.214,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bDu",
   "roundness": null,
   "seed": 1543863886,
   "version": 4,
   "versionNonce": 1554286994,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791145044914,
   "created": 1791145044908,
   "link": null,
   "locked": false,
   "text": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "mDZd7TErVz5N4SO57mmlU",
   "originalText": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
