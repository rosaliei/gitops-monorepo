   "roundness": null,
   "seed": 1148338894,
   "version": 4,
   "versionNonce": 1490504978,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791141164376,
   "created": 1791141164371,
   "link": null,
   "locked": false,
   "text": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "jtPTMVlTZr6t27YN6f-aL",
   "originalText": "2  CI never touches the cluster\nActions only tests, builds, edits Git\nArgoCD pulls from inside the cluster",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "P94JRyFBHA2QeI7yP6sd_",
   "type": "text",
   "x": 3292.166,
